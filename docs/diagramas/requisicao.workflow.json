  "cards": [
    {
      "dot": "amber",
      "title": "Espera",
      "items": [
        "Backoff: sorteio em [0, 2^tentativa] (full jitter)",
        "Retry-After vale em 429 e 503, com teto retry_after_teto",
        "A espera acorda se cancelado for acionado"
      ]
    },
    {
      "dot": "rose",
      "title": "modo_404",
      "items": [
        "ausente: devolve None (CNPJ ou resultado não existe)",
        "erro: ItensIndisponiveis (listagem de um registro)",
        "retry: trata como transitória (listagens em lote)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Falha ≠ ausência",
      "items": [
        "422 retenta no máximo 2 vezes",
        "Sob storm a escada cai para tentativas_curtas"
      ]
    }
  ]
